{
  "name": "zerohop",
  "version": "0.36.28",
  "description": "Compartilhamento de tela, chat de voz e chat de texto P2P via WebRTC, sem servidor",
  "main": "./out/main/index.js",
  "author": {
    "name": "Murilo Barbosa",
    "url": "https://github.com/murilobarbosa2002"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/murilobarbosa2002/zerohop"
  },
  "homepage": "https://murilobarbosa2002.github.io/zerohop/",
  "bugs": {
    "url": "https://github.com/murilobarbosa2002/zerohop/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b --noEmit",
    "dist": "electron-builder",
    "dist:local": "electron-builder --win dir -c.win.signAndEditExecutable=false",
    "lint:md": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && node e2e/run-all.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.6",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "markdownlint-cli": "^0.49.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.zerohop.app",
    "productName": "ZeroHop",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/loopback-capture/**",
      "**/node_modules/node-window-manager/**",
      "**/node_modules/extract-file-icon/**",
      "**/node_modules/uiohook-napi/**"
    ],
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "murilobarbosa2002",
      "repo": "zerohop"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true,
    "node-window-manager@2.2.4": true,
    "extract-file-icon@0.3.2": true,
    "uiohook-napi@1.5.5": true
  },
  "overrides": {
    "node-gyp": "^13.0.2"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "loopback-capture": "^3.0.2",
    "node-window-manager": "^2.2.4",
    "peerjs": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "tailwind-variants": "^3.3.1",
    "uiohook-napi": "^1.5.5",
    "zod": "^3.25.76"
  }
}
