{
  "name": "screen-share",
  "version": "0.18.0",
  "description": "Compartilhamento de tela P2P via WebRTC, sem servidor",
  "main": "./out/main/index.js",
  "author": "murilobarbosa2002",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b --noEmit",
    "dist": "electron-builder",
    "dist:local": "electron-builder --win dir -c.win.signAndEditExecutable=false",
    "lint:md": "markdownlint \"**/*.md\" \".claude/**/*.md\" --ignore \"**/node_modules/**\""
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.6",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.screenshare.app",
    "productName": "ScreenShare",
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "murilobarbosa2002",
      "repo": "electron-screen-share"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "peerjs": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^3.25.76"
  }
}
